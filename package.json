{
  "name": "theme-vdoing-blog",
  "version": "1.0.0",
  "scripts": {
    "dev": "export NODE_OPTIONS='--localstorage-file=/tmp/vuepress-localstorage.json' && node --max_old_space_size=8192 ./node_modules/.bin/vuepress dev docs",
    "build": "export NODE_OPTIONS='--localstorage-file=/tmp/vuepress-localstorage.json' && node --max_old_space_size=12288 ./node_modules/.bin/vuepress build docs",
    "build:time": "echo '⏱ 开始构建...' && date '+开始时间: %Y-%m-%d %H:%M:%S' && time (export NODE_OPTIONS='--localstorage-file=/tmp/vuepress-localstorage.json' && node --max_old_space_size=12288 ./node_modules/.bin/vuepress build docs) && echo '' && date '+结束时间: %Y-%m-%d %H:%M:%S'",
    "dev:win": "set NODE_OPTIONS=--localstorage-file=C:\\temp\\vuepress-localstorage.json && node --max_old_space_size=8192 ./node_modules/.bin/vuepress dev docs",
    "build:win": "set NODE_OPTIONS=--localstorage-file=C:\\temp\\vuepress-localstorage.json && node --max_old_space_size=8192 ./node_modules/.bin/vuepress build docs",
    "deploy": "bash deploy.sh",
    "editFm": "node utils/editFrontmatter.js",
    "baiduPush": "node utils/baiduPush.js https://yccoding.com && bash baiduPush.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "dayjs": "^1.9.7",
    "inquirer": "^7.1.0",
    "json2yaml": "^1.1.0",
    "vuepress": "^1.9.9",
    "vuepress-theme-vdoing": "^1.12.9",
    "yamljs": "^0.3.0"
  }
}
