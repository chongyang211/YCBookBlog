{
  "name": "theme-vdoing-blog",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --max_old_space_size=18192 ./node_modules/.bin/vuepress dev packages/website",
    "build": "node --max_old_space_size=18192 ./node_modules/.bin/vuepress build packages/website",
    "build:time": "echo '⏱ 开始构建...' && date '+开始时间: %Y-%m-%d %H:%M:%S' && time node --max_old_space_size=8192 ./node_modules/.bin/vuepress build packages/website && echo '' && date '+结束时间: %Y-%m-%d %H:%M:%S'",
    "dev:win": "set NODE_OPTIONS=--localstorage-file=C:\\temp\\vuepress-localstorage.json && node --max_old_space_size=8192 ./node_modules/.bin/vuepress dev packages/website",
    "build:win": "set NODE_OPTIONS=--localstorage-file=C:\\temp\\vuepress-localstorage.json && node --max_old_space_size=8192 ./node_modules/.bin/vuepress build packages/website",
    "deploy": "bash deploy.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "dayjs": "^1.9.7",
    "inquirer": "^7.1.0",
    "json2yaml": "^1.1.0",
    "mermaid": "^9.4.3",
    "vuepress": "^1.9.9",
    "vuepress-plugin-mermaidjs": "^2.0.0-beta.2",
    "vuepress-theme-vdoing": "^1.12.9",
    "yamljs": "^0.3.0"
  }
}
