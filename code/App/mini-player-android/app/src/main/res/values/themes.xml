<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      基于 Material3 DayNight：
      - values/ 下浅色；values-night/ 同名覆盖 → 系统深色自动切换（文档 §08.3）
      - android:colorBackground 用框架属性：冷启动无白闪
    -->
    <style name="Theme.MiniPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_pink</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/bg_light</item>
    </style>
</resources>
