
// 评论区颜色重置
.gt-container
  .gt-ico-tip
    &::after
      content: '。( Win + . ) 或 ( ⌃ + ⌘ + ␣ ) 打开表情'
      color: #999
      font-size: .8rem
  .gt-meta
    border-color var(--borderColor)!important
  .gt-comments-null
    color var(--textColor)
    opacity .5
  .gt-header-textarea
    color var(--textColor)
    background rgba(180,180,180,0.1)!important
  .gt-btn
    border-color $accentColor!important
    background-color $accentColor!important
  .gt-btn-preview
    background-color rgba(255,255,255,0)!important
    color $accentColor!important
  a
    color $accentColor!important
  .gt-svg svg
    fill $accentColor!important
  .gt-comment-content,.gt-comment-admin .gt-comment-content
    background-color rgba(150,150,150,0.1)!important
    &:hover
      box-shadow 0 0 25px rgba(150,150,150,.5)!important
    .gt-comment-body
      color var(--textColor)!important


// qq徽章
.qq
  position: relative;
.qq::after
  content: "可撩";
  background: $accentColor;
  color:#fff;
  padding: 0 5px;
  border-radius: 10px;
  font-size:12px;
  position: absolute;
  top: -4px;
  right: -35px;
  transform:scale(0.85);

// demo模块图标颜色
body .vuepress-plugin-demo-block__wrapper
  &,.vuepress-plugin-demo-block__display
    border-color rgba(160,160,160,.3)
  .vuepress-plugin-demo-block__footer:hover
    .vuepress-plugin-demo-block__expand::before
      border-top-color: $accentColor !important;
      border-bottom-color: $accentColor !important;
    svg
      fill: $accentColor !important;

// 全文搜索框
.suggestions
  overflow: auto
  max-height: calc(100vh - 6rem)
  @media (max-width: 719px) {
    width: 90vw;
    min-width: 90vw!important;
    margin-right: -20px;
  }
  .highlight
    color: $accentColor
    font-weight: bold

// ============ 博主信息模块美化 ============

// 博主区域整体
.blogger-wrapper
  text-align center
  margin-top 1.2rem
  padding 1.8rem 1rem 1.5rem

  // 头像
  .avatar
    margin 0 auto 0.8rem
    img
      width 80px !important
      height 80px !important
      border-radius 50%
      border 3px solid var(--borderColor, #e8e8e8)
      box-shadow 0 2px 12px rgba(100, 100, 100, 0.15)
      transition all 0.3s ease
      &:hover
        transform scale(1.06)
        box-shadow 0 4px 20px rgba(100, 100, 100, 0.25)

  // 昵称
  .blogger-name
    font-size 1.1rem
    font-weight 600
    color var(--textColor, #2c3e50)
    margin-bottom 0.35rem
    letter-spacing 0.5px

  // 个性签名
  .slogan
    font-size 0.82rem
    color var(--textColor, #666)
    opacity 0.65
    margin-bottom 1rem
    letter-spacing 0.25px

// ============ 社交图标美化 ============

// 社交图标容器
.social-wrapper
  display flex
  justify-content center
  gap 12px

  a.social-item
    display inline-flex
    align-items center
    justify-content center
    width 36px
    height 36px
    border-radius 50%
    background var(--bgColor, #f5f5f5)
    color var(--textColor, #666)
    font-size 1.05rem
    transition all 0.25s ease

    &:hover
      background $accentColor
      color #fff
      transform translateY(-3px)
      box-shadow 0 4px 12px rgba($accentColor, 0.35)
      text-decoration none

    .iconfont
      font-size inherit


// ============================================================
// 首页全屏击穿（最高优先级）
//
// 触发条件：.theme-container 上带有 home-fullwidth-container class
// 注入方式（双保险）：
//   主路径：docs/index.md frontmatter.pageClass: home-fullwidth-container
//          → vdoing Layout.vue 第 195 行 pageClasses() 读取并绑到
//            .theme-container 上，SSR 阶段就生效（首屏即铺满，无抖动）
//   兜底：HomePage.vue mounted -> applyFullWidth() 也会再追加一次，
//         覆盖任何客户端路由切换的边界情况
//
// 击穿做的事：
//   1. .theme-container 自身去掉主题 max-width 限制
//   2. 覆盖 vdoing mobile.styl
//      .theme-container.sidebar-open .page { padding-left: $sidebarWidth + .8rem }
//      让 .page 真正铺满视口
//   3. **关键**：覆盖 vdoing/components/Page.vue 中
//      .page > * { @extend $vdoing-wrapper }  // → max-width: 860px
//      把 .theme-vdoing-wrapper / .theme-vdoing-content / .hp-wrapper
//      整条祖先链都强制 width:100%（之前只覆盖 .theme-vdoing-wrapper
//      一层，结果内层 .theme-vdoing-content 仍受限，HomePage 被压成左半屏）
//   4. 隐藏 sidebar / right-menu / page-edit / page-nav 等无关元素
//   5. footer 也铺满
//
// 注意：本规则放在主题级入口 docs/.vuepress/styles/index.styl，
// 这是 vuepress 用户级样式入口，注入位置在 vdoing 主题样式之后，
// 权威级最高，避免被主题覆盖。
// ============================================================
html.home-fullwidth, body.home-fullwidth
  margin 0 !important
  padding 0 !important

.theme-container.home-fullwidth-container
  max-width none !important
  width 100% !important
  padding 0 !important
  margin 0 !important

  // 强制 .page 全宽，覆盖 sidebar-open 的 padding-left
  .page
    padding-left 0 !important
    padding-right 0 !important
    padding-bottom 0 !important
    padding-top 3.6rem !important
    max-width none !important
    width 100% !important
    margin 0 !important
    box-sizing border-box !important

  // 即使带 sidebar-open / have-rightmenu / no-sidebar 等修饰也强制覆盖
  &.sidebar-open .page,
  &.have-rightmenu .page,
  &.no-sidebar .page,
  &.on-sidebar .page
    padding-left 0 !important
    padding-right 0 !important

  // ----------------------------------------------------------
  // 祖先链全宽（关键修复）：
  // vdoing 的 Page.vue 用 stylus 写了
  //   .page > * { @extend $vdoing-wrapper }   // → max-width: 860px
  // 受影响的就是 .theme-vdoing-wrapper。我们**必须**把祖先链上
  // 每一层可能被限宽的元素都强制 100%，包括 vdoing 用 v-if/v-else
  // 包出来的 .theme-vdoing-content 以及 HomePage 自己的 .hp-wrapper。
  // 任何一层漏掉，子元素就会被父级 max-width 兜住，看起来"偏左"。
  // ----------------------------------------------------------

  // 1. .page 的所有直接子元素（包括 .theme-vdoing-wrapper、UpdateArticle 等）
  .page > *
    max-width none !important
    width 100% !important
    margin 0 !important
    padding 0 !important
    background transparent !important
    box-shadow none !important
    border-radius 0 !important

  // 2. theme-vdoing-wrapper 内层（HomePage 通过 <component :is> 渲染在这一层）
  .theme-vdoing-wrapper,
  .theme-vdoing-wrapper > .theme-vdoing-content
    max-width none !important
    width 100% !important
    margin 0 !important
    padding 0 !important
    background transparent !important

  // 3. HomePage 自己的根（.hp-wrapper）也强制全宽，避免被任何隐性 inline-block / shrink-to-fit 影响
  .hp-wrapper
    max-width none !important
    width 100% !important
    margin 0 !important

  // 屏蔽无关元素
  .theme-vdoing-wrapper > .placeholder,
  .theme-vdoing-wrapper > .content-wrapper,
  .theme-vdoing-wrapper > .page-edit,
  .theme-vdoing-wrapper > .page-nav,
  .page > .update-bar,
  .right-menu-wrapper,
  .sidebar,
  .sidebar-mask,
  .sidebar-button,
  .sidebar-hover-trigger
    display none !important

  // footer 铺满
  .footer
    max-width none !important
    width 100% !important
    margin 0 !important
    padding-left 0 !important
    padding-right 0 !important
    border-radius 0 !important

  &.have-rightmenu .footer,
  &.no-sidebar .footer
    max-width none !important
    width 100% !important
    margin 0 !important

// 移动端导航栏高度兼容
@media (max-width: 719px)
  .theme-container.home-fullwidth-container .page
    padding-top 3.6rem !important
