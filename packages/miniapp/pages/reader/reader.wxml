<!-- 阅读页 -->
<scroll-view class="container" scroll-y>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" style="text-align:center;padding:200rpx 0;">
    <text class="text-muted">正在加载…</text>
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{error}}" style="text-align:center;padding:200rpx 0;">
    <text class="text-muted" style="display:block;margin-bottom:24rpx;">加载失败，请检查网络</text>
    <view class="tag tag-purple" bindtap="onRetry">点击重试</view>
  </view>

  <!-- 正常内容 -->
  <view wx:else>
    <!-- 文章头部 -->
    <view class="chapter-header">
      <view class="chapter-title">{{title}}</view>

      <view style="margin-top:16rpx;display:flex;align-items:center;flex-wrap:wrap;">
        <!-- 日期 -->
        <text wx:if="{{date}}" class="card-meta" style="margin-right:24rpx;">{{date}}</text>

        <!-- 分类标签 -->
        <view
          wx:for="{{categories}}"
          wx:key="*this"
          class="tag tag-purple"
        >{{item}}</view>
      </view>

      <!-- 作者信息 -->
      <view wx:if="{{author.name}}" style="margin-top:12rpx;">
        <text class="card-meta">{{author.name}}</text>
      </view>
    </view>

    <!-- 正文 -->
    <rich-text nodes="{{htmlContent}}" class="rich-content" />

    <!-- 底部翻页导航 -->
    <view style="display:flex;justify-content:space-between;align-items:center;padding:40rpx 32rpx 24rpx;border-top:1rpx solid rgba(255,255,255,0.06);margin:0 32rpx;">
      <view wx:if="{{prev}}" class="tag tag-purple" bindtap="onPrev" style="margin-right:0;">← 上一篇</view>
      <view wx:else style="width:160rpx;"></view>

      <view wx:if="{{next}}" class="tag tag-purple" bindtap="onNext" style="margin-right:0;">下一篇 →</view>
      <view wx:else style="width:160rpx;"></view>
    </view>

    <!-- 底部操作 -->
    <view style="text-align:center;padding:8rpx 0 60rpx;margin:0 32rpx;">
      <text class="tag tag-purple" bindtap="onOpenInBrowser">在浏览器中打开原文</text>
    </view>
  </view>

</scroll-view>
